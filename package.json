{
  "name": "@rokmohar/medusa-payment-manual",
  "version": "1.1.0",
  "description": "Manual payment plugin for Medusa 2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "author": "Rok Mohar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokmohar/medusa-payment-manual.git"
  },
  "homepage": "https://github.com/rokmohar/medusa-payment-manual#readme",
  "bugs": {
    "url": "https://github.com/rokmohar/medusa-payment-manual/issues"
  },
  "scripts": {
    "build": "rimraf dist && tsc --build ./tsconfig.json",
    "watch": "tsc --watch",
    "prepublishOnly": "yarn build",
    "lint": "eslint --ext .js,.ts src --cache --cache-strategy content",
    "lint:fix": "eslint --ext .js,.ts src --fix --cache --cache-strategy content",
    "typecheck": "tsc --noEmit --pretty --project tsconfig.json",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-strategy content --log-level warn",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --cache --cache-strategy content --log-level warn"
  },
  "devDependencies": {
    "@medusajs/framework": "2.22.2",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.19.0"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-payment-manual",
    "medusa-plugin",
    "medusa-plugin-integration",
    "medusa-plugin-payment"
  ],
  "packageManager": "yarn@4.14.1"
}
